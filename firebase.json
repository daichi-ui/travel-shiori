{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "hosting-redirect",
    "redirects": [
      {
        "source": "/:path*",
        "destination": "https://daichi-ui.github.io/travel-shiori/:path*",
        "type": 301
      }
    ]
  }
}
