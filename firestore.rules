rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    function isMember(tripId) {
      return signedIn()
        && myEmail() in get(/databases/$(database)/documents/trips/$(tripId)).data.memberEmails;
    }

    match /trips/{tripId} {
      // 一覧取得は「memberEmails に自分を含む」クエリだけ許可される
      allow read: if signedIn() && myEmail() in resource.data.memberEmails;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == myEmail()
        && request.resource.data.memberEmails == [myEmail()];

      // メンバーは編集できるが、作成者とメンバー構成は作成者しか変えられない
      // 作成者をメンバーから外すことはできない
      allow update: if signedIn()
        && myEmail() in resource.data.memberEmails
        && request.resource.data.ownerUid == resource.data.ownerUid
        // ownerEmail が無い古いしおりは、作成者が自分のメールアドレスで補える
        && ('ownerEmail' in resource.data
            ? request.resource.data.ownerEmail == resource.data.ownerEmail
            : resource.data.ownerUid == request.auth.uid
              && request.resource.data.ownerEmail == myEmail())
        && request.resource.data.ownerEmail in request.resource.data.memberEmails
        && request.resource.data.memberEmails.size() <= 20
        && (resource.data.ownerUid == request.auth.uid
            || request.resource.data.memberEmails == resource.data.memberEmails);

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /schedules/{scheduleId} {
        allow read, write: if isMember(tripId);
      }

      match /packingItems/{itemId} {
        allow read, write: if isMember(tripId);
      }
    }
  }
}
